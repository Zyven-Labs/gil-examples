intent set_source(Node)
    source[Node] <= true
end

intent amplify()
    repeat
        when source[A] do
            when linked[A, B] do
                activated[B] <= true
            end
        end
    end
end

intent cascade()
    repeat
        when activated[A] do
            when linked[A, B] do
                activated[B] <= true
            end
        end
    end
end